<?xml version="1.0" encoding="UTF-8"?>
<!--
  A second machine's chats, pushed to the machine that runs the ingest (librarian collect hourly-to), a launchd agent. Render it with
    sed -e "s|@LIBRARIAN@|$(command -v librarian)|" -e "s|@CONFIG@|$HOME/.config/librarian/librarian.toml|" \
      -e "s|@DEST@|host:/path/to/wiki|" -e "s|@LOG@|$HOME/Library/Logs/librarian-collect.log|" \
      units/launchd/librarian-collect.plist.tmpl > ~/Library/LaunchAgents/librarian.collect.plist
  then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/librarian.collect.plist
  Every 15 minutes; the hourly switch does nothing until an hour has passed. The machine that runs the ingest needs
  none of this: librarian ingest collects its own chats first.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>librarian.collect</string>
    <key>ProgramArguments</key>
    <array>
        <string>@LIBRARIAN@</string>
        <string>--config</string>
        <string>@CONFIG@</string>
        <string>collect</string>
        <string>--hourly</string>
        <string>--to</string>
        <string>@DEST@</string>
        <string>--rsh</string>
        <string>ssh -o BatchMode=yes -o ConnectTimeout=10</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd gives a minimal PATH; git, rsync and python3 live in Homebrew -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
