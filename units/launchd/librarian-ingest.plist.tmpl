<?xml version="1.0" encoding="UTF-8"?>
<!--
  The nightly ingest on macOS (librarian ingest), a launchd agent. Render it with
    sed -e "s|@LIBRARIAN@|$(command -v librarian)|" -e "s|@CONFIG@|$HOME/.config/librarian/librarian.toml|" \
      -e "s|@LOG@|$HOME/Library/Logs/librarian-ingest.log|" \
      units/launchd/librarian-ingest.plist.tmpl > ~/Library/LaunchAgents/librarian.ingest.plist
  then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/librarian.ingest.plist
  Run now: launchctl kickstart -p gui/$(id -u)/librarian.ingest
  04:15 local. RunAtLoad is false so loading it does not fire a run.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>librarian.ingest</string>
    <key>ProgramArguments</key>
    <array>
        <string>@LIBRARIAN@</string>
        <string>--config</string>
        <string>@CONFIG@</string>
        <string>ingest</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd gives a minimal PATH; claude, git and python3 live in Homebrew or ~/.local/bin -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>15</integer>
    </dict>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
