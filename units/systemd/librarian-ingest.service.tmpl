# The brain's nightly ingest on Linux (scripts/brain-ingest.sh). Template: scripts/brain-ingest.sh install.
[Unit]
Description=Swarm brain ingest [${SWARM_UNIT_PREFIX}]

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SWARM_NAME=${SWARM_NAME:-}
ExecStart=/bin/bash ${SWARM_REPO}/scripts/brain-ingest.sh run
# A run killed by its timeout or a signal never reaches its own alerts; this says so, once
# (scripts/job-alert.sh). The "-" keeps a failed alert from failing the unit.
ExecStopPost=-/bin/bash ${SWARM_REPO}/scripts/job-alert.sh unit brain-ingest
# Stage A is bounded by BRAIN_LOCAL_MAX_SECONDS (an hour); the whole run never past two.
TimeoutStartSec=2h
StandardOutput=append:${SWARM_STATE_DIR}/backups/brain-ingest.log
StandardError=append:${SWARM_STATE_DIR}/backups/brain-ingest.log
