# The nightly ingest on Linux (librarian ingest), a systemd user service. Render it with
#   sed -e "s|@LIBRARIAN@|$(command -v librarian)|" -e "s|@CONFIG@|$HOME/.config/librarian/librarian.toml|" \
#     units/systemd/librarian-ingest.service.tmpl > ~/.config/systemd/user/librarian-ingest.service
# copy librarian-ingest.timer next to it, then: systemctl --user daemon-reload &&
# systemctl --user enable --now librarian-ingest.timer (and loginctl enable-linger to run logged out).
[Unit]
Description=librarian ingest

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@LIBRARIAN@ --config @CONFIG@ ingest
# Stage A is bounded by BRAIN_LOCAL_MAX_SECONDS (an hour); the whole run never past two.
TimeoutStartSec=2h
