# The brain's nightly ingest at 04:15, after the 03:30 backup; Persistent catches a run missed
# while the machine was off. Installed by scripts/brain-ingest.sh install.
[Unit]
Description=Swarm brain ingest at 04:15

[Timer]
OnCalendar=*-*-* 04:15:00
Persistent=true

[Install]
WantedBy=timers.target
